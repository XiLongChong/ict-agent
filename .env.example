DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
ICT_DATA_DIR=data/raw
ICT_DATABASE_PATH=data/processed/ict_agent.duckdb
ICT_CASE_DATABASE_PATH=data/processed/ict_agent_cases.duckdb

# 可选：企业自建飞书应用。两项同时填写后，服务启动时建立长连接。
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 飞书案件卡片跳转地址；本地演示可留空，部署后填写可访问的 HTTPS 地址。
ICT_PUBLIC_BASE_URL=

# Docker Compose 对外端口及服务器数据目录。容器内路径由 Compose 固定，无需修改。
ICT_PORT=8000
ICT_SERVER_DATA_DIR=./data/raw
ICT_SERVER_PROCESSED_DIR=./data/processed

# 国内服务器无法直连 Docker Hub 或 npm 时，指定镜像加速前缀后重新构建。
# 例如：ICT_BASE_REGISTRY=docker.m.daocloud.io/library/  ICT_NPM_REGISTRY=https://registry.npmmirror.com
ICT_BASE_REGISTRY=
ICT_NPM_REGISTRY=
